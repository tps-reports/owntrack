node:
  name: owntrack
  type: flutter
  category: demo
  description: OwnTracks-compatible location sharing with MQTT and maps

static_app: {}

build:
  dart_defines:
    MAPS_API_KEY: "${MAPS_API_KEY:-}"
  platforms: [android_apk]

connections:
  - target: mosquitto
    type: mqtt
  - target: nginx
    type: gateway

environments:
  prod:
    mode: host_artifact
    targets:
      android_apk: adb_install
